{
  "name": "osmp",
  "version": "1.0.0",
  "private": false,
  "description": "Autonomous enterprise-grade AI Open Source Modernization Intelligence Platform. An agent-based engineering organization that discovers, modernizes, and contributes improvements to overlooked open-source projects.",
  "keywords": [
    "open-source",
    "automation",
    "ai",
    "agents",
    "github",
    "modernization",
    "devops",
    "oss",
    "enterprise"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nortaq-PlayNexus/osmp.git"
  },
  "bugs": {
    "url": "https://github.com/Nortaq-PlayNexus/osmp/issues"
  },
  "homepage": "https://github.com/Nortaq-PlayNexus/osmp#readme",
  "main": "src/cli.ts",
  "bin": {
    "osmp": "src/cli.ts"
  },
  "files": [
    "src",
    "docs",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "discover": "node src/cli.ts discover",
    "discover:dry": "node src/cli.ts discover --dry-run",
    "audit": "node src/cli.ts audit",
    "modernize": "node src/cli.ts modernize",
    "pipeline": "node src/cli.ts pipeline",
    "list": "node src/cli.ts list",
    "test": "node --test \"tests/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.23.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
