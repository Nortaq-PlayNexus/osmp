# GitHub personal access token (classic with repo scope, or fine-grained with repo permissions)
# Required for authenticated search rate limits and forking/PR operations.
GITHUB_TOKEN=
GITHUB_OWNER=

# Repository acquisition
WORKSPACE_ROOT=./data/workspaces
MEMORY_DIR=./data/memory
PORTFOLIO_DIR=./data/portfolio

# Discovery
TOP_REPOSITORIES=5
MIN_STARS=50
MAX_STARS=5000
SCORE_THRESHOLD=80
SEARCH_QUERIES=10
DRY_RUN=true

# GitHub GraphQL (optional, higher search limits)
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# CI
MAX_PARALLEL_AGENTS=4
